PORT=4100
NODE_ENV=development

# Arc (Circle's stablecoin L1). viem ships default public RPC endpoints for
# both networks — set these only to override with your own provider
# (Alchemy/QuickNode/etc.), recommended in production for reliability/rate limits.
#
# The Zela app itself only supports Arc MAINNET (no testnet Arc chain is
# defined there) — anything meant to be recognizable/payable by a real Zela
# app user (e.g. Payment Rails merchant IDs) only works on arc-mainnet.
ARC_NETWORK=arc-mainnet
ARC_TESTNET_RPC_URL=
ARC_MAINNET_RPC_URL=
# Required only when ARC_NETWORK=arc-testnet. Same address as mainnet's,
# per confirmation from the project owner (consistent with this being a
# fixed native-USDC precompile address rather than a per-network deployed
# contract) — not independently verified against docs.arc.io the way the
# mainnet address was (see packages/shared/src/tokens.ts).
ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Fee-payer EVM private key (0x-prefixed, 32 bytes), funded with Arc-native
# USDC for gas. Pays network fees for settlement sweeps and receives the
# platform fee — see docs/ARCHITECTURE.md "Fees".
# Generate: node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
SETTLEMENT_FEE_PAYER_SECRET_KEY=

# Postgres
# If the server is shared with other apps, append ?options=-c%20search_path%3Dzela_checkout so tables live in their own schema.
DATABASE_URL=postgres://localhost:5432/zela_checkout

# Platform fee
PLATFORM_FEE_BPS=100

# Hosted checkout page origin (for CORS + generating checkoutUrl)
CHECKOUT_WEB_ORIGIN=http://localhost:4200

# Zela app deep link scheme, for the "Pay with Zela" path
ZELA_APP_SCHEME=zela://pay

# 32-byte AES-256-GCM key (64 hex chars) encrypting per-session deposit keys at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEPOSIT_KEY_ENCRYPTION_KEY=

# Reverse proxies in front of the API (0 = none). Set to 1 behind nginx/Cloudflare so rate limits see real IPs.
TRUST_PROXY=0
# Allow webhook URLs on private/localhost addresses. NEVER true in production (SSRF).
ALLOW_PRIVATE_WEBHOOK_URLS=false

# Optional — Firebase Auth (Admin SDK), for merchant signup/login via
# Firebase's email/password and Google providers (see routes/auth.ts).
# Left unset, that path is disabled and the plain-password login/signup
# below still works unchanged. The full service account JSON, minified to
# one line, single-quoted (double quotes would make dotenv mangle the
# private key's embedded \n sequences — see apps/api/.env for a real one).
# Download from Firebase Console → Project Settings → Service Accounts.
FIREBASE_SERVICE_ACCOUNT_JSON=
