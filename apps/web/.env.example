NEXT_PUBLIC_API_URL=http://localhost:4100
# zela-app only supports Arc mainnet — this must match apps/api's ARC_NETWORK.
NEXT_PUBLIC_ARC_NETWORK=arc-mainnet
# viem ships default public RPC endpoints for both networks — set this only
# to override with your own provider.
NEXT_PUBLIC_ARC_RPC_URL=
# Required only when NEXT_PUBLIC_ARC_NETWORK=arc-testnet. Same address as
# mainnet's, per confirmation from the project owner — see apps/api's
# .env.example for the same note.
NEXT_PUBLIC_ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Publishable key for the landing page's live "try it" demo — safe to expose
# (that's what a publishable key is for). Seeded once against a "Zela Demo
# Store" merchant; see apps/api's seed step in README.md.
NEXT_PUBLIC_DEMO_PUBLISHABLE_KEY=

# WalletConnect/Reown Cloud project ID (cloud.reown.com) — powers RainbowKit's
# wallet-connect modal (mobile-wallet QR pairing, etc.). Safe to expose; it
# identifies your app to the WalletConnect relay, it isn't a secret.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Firebase client config (Project Settings → General → Your apps → SDK
# setup) — powers merchant signup/login (email/password + Google), see
# lib/firebaseClient.ts. This is a client identifier, not a secret — the
# server-side Admin SDK key that actually needs protecting lives in
# apps/api's FIREBASE_SERVICE_ACCOUNT_JSON instead. Login/signup requires
# ALL of these plus apps/api's key to be set — leave every var below blank
# to keep the plain-password auth form working with Firebase sign-in options
# just hidden.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
